  "author": "AstralJays / JaysWakeZone (fork)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JustinDPerkins/damn-vulnerable-ai-agent.git"
  },
  "homepage": "https://github.com/JustinDPerkins/damn-vulnerable-ai-agent#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "aim-core": "file:./vendor/aim-core",
    "js-yaml": "^4.1.1",
    "openai": "^6.21.0",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "fast-uri": "^4.1.5"
  }
}
