{
  "name": "damn-vulnerable-ai-agent",
  "version": "0.9.3",
  "description": "JaysWakeZone AI agent threat lab — intentionally vulnerable agents for security training.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dvaa": "src/index.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"src/**/*.test.js\"",
    "test:fleet": "node scripts/test-fleet.mjs",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "start": "node src/index.js",
    "start:all": "node src/index.js --all",
    "start:api": "node src/index.js --api",
    "start:mcp": "node src/index.js --mcp",
    "start:a2a": "node src/index.js --a2a",
    "dev": "node --watch src/index.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "keywords": [
    "ai-security",
    "vulnerable",
    "testing",
    "mcp",
    "a2a",
    "llm",
    "agent",
    "security-training",
    "ctf",
    "hackmyagent"
